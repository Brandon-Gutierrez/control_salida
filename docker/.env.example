# Copia este archivo a .env y completa los valores. .env NO se versiona.

# --- Repositorios de código (rutas relativas a esta carpeta, o absolutas) ---
# Servidor: backend/docker (esta carpeta) y web clonados lado a lado, por lo que esto es lo normal.
BACKEND_PATH=..
WEB_PATH=../../web

# --- Acceso público ----------------------------------------------------------
# Nombre (o IP) con el que se entra al sistema; si el HTTPS no va en el 443, añade el puerto
# (ej. midominio.com:8443). Lo usan Sanctum, APP_URL y el certificado autofirmado.
PUBLIC_HOST=localhost
HTTP_PORT=80
HTTPS_PORT=443
# Solo modo desarrollo
DEV_HTTP_PORT=8080
DEV_DB_PORT=15432
DEV_REDIS_PORT=16379
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# --- Versiones ----------------------------------------------------------------
FLUTTER_VERSION=3.47.0
PHP_VERSION=8.4
POSTGRES_VERSION=17

# URL del backend que se incrusta al compilar la web. Vacía = mismo dominio (recomendado).
API_BASE_URL=

# --- Aplicación ----------------------------------------------------------------
APP_NAME=ControlSalida
APP_LOCALE=en
LOG_LEVEL=warning
SESSION_LIFETIME=5256000
# Genera una nueva con:  docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=

# --- Base de datos y Redis ------------------------------------------------------
DB_DATABASE=control_leaves
DB_USERNAME=control
DB_PASSWORD=
REDIS_PASSWORD=

# --- Administrador inicial -------------------------------------------------------
# Se siembra un ADMIN con este item; inicia sesión con sus credenciales de Comteco.
SUPERADMIN_ITEM=
SUPERADMIN_NAME=

# --- Servicio externo (Comteco) ---------------------------------------------------
KEY_SOFTWARE=
API_LOGIN=
API_LOGINWITHCARNET=
API_GETEMPLOYEE=
API_GETREASONS=
API_GETCHECKOUT=
API_REGISTERCHECKOUT=
