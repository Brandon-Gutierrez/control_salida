# Despliegue de la API. Copia este archivo a .env y completa los valores. .env NO se versiona.

# --- Acceso ------------------------------------------------------------------
# Dirección pública de la WEB, sin https:// (el dominio que asigne Comteco;
# mientras tanto, la IP del servidor). Si la web no usa el puerto 443, añádelo
# (ej. salidas.comteco.com.bo:9443). La usan Sanctum, APP_URL, CORS y el
# certificado autofirmado: debe coincidir con PUBLIC_HOST en el .env de la web.
PUBLIC_HOST=localhost
# Puerto HTTPS de la API en este servidor (app móvil y otros clientes). La web
# del mismo servidor no lo usa.
API_HTTPS_PORT=8443
# Red de Docker compartida con la web y su rango (el de `docker network create --subnet`).
# TRUSTED_PROXY: de ahí se acepta la IP real que informa la web.
SHARED_NETWORK=control-salidas
TRUSTED_PROXY=172.30.0.0/24

# --- Versiones ----------------------------------------------------------------
PHP_VERSION=8.4

# --- Aplicación ----------------------------------------------------------------
APP_NAME=ControlSalida
APP_LOCALE=en
LOG_LEVEL=warning
SESSION_LIFETIME=5256000

# Geocerca: radio al predio del QR y peor precisión de GPS aceptada (metros).
GEOFENCE_RADIUS_METERS=50
GEOFENCE_MAX_ACCURACY_METERS=30

# Clave de cifrado. Para generar una nueva, en cualquier copia del backend con PHP:
#   php artisan key:generate --show
APP_KEY=

# --- PostgreSQL (servidor externo) ----------------------------------------------
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
# Si la contraseña tiene $, # o espacios, escríbela entre comillas simples.
DB_PASSWORD=
# prefer (usa TLS si el servidor lo ofrece) | require (lo exige) | disable.
DB_SSLMODE=prefer

# --- Redis (servidor externo) ---------------------------------------------------
REDIS_HOST=
REDIS_PORT=6379
# tcp | tls
REDIS_SCHEME=tcp
# Déjalos vacíos si el servidor no los pide.
REDIS_USERNAME=
REDIS_PASSWORD=
# Número de base de Redis.
REDIS_DB=0

# --- Administrador inicial -------------------------------------------------------
# `db:seed` crea un ADMIN con este item; inicia sesión con sus credenciales de Comteco.
SUPERADMIN_ITEM=
SUPERADMIN_NAME=

# --- Servicio externo (Comteco) ---------------------------------------------------
KEY_SOFTWARE=
API_LOGIN=
API_LOGINWITHCARNET=
API_GETEMPLOYEE=
API_GETREASONS=
API_GETCHECKOUT=
API_LISTOUTPUTBYITEM=
API_REGISTERCHECKOUT=
